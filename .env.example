# Local evidence mode works without external credentials.
COMPASS_MODE=local
COMPASS_DEMO_IDENTITIES=true
# Live mode uses real embeddings and generation; no automatic provider fallback.
# COMPASS_MODE=live
# OPENAI_API_KEY=
COMPASS_CHAT_MODEL=gpt-5.4-mini-2026-03-17
COMPASS_EMBEDDING_MODEL=text-embedding-3-small
COMPASS_JUDGE_MODEL=gpt-5.5-2026-04-23
# DATABASE_URL=postgresql+psycopg://compass:compass_dev_only@localhost:5432/compass
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-compass
# Enable remote trace summaries only. Model context is excluded from automatic tracing.
COMPASS_REMOTE_TRACING=false
# Real OIDC requires COMPASS_DEMO_IDENTITIES=false and .streamlit/secrets.toml.

# Week 6 protected test mode. Keep demo mode only for explicit persona demonstrations.
# COMPASS_AUTH_MODE=token
# JSON mapping of random credentials (32+ characters) to fixed synthetic actor IDs.
# Set this locally, never commit real credentials. Missing/invalid mappings deny access.
# COMPASS_TEST_TOKENS={}
